<UserControl x:Class="Cats.Telescope.VsExtension.Views.MainWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:e="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:core="clr-namespace:Cats.Telescope.VsExtension.Core"
             xmlns:bindTreeViewExpand="clr-namespace:Cats.Telescope.VsExtension.Core.Behaviors"
             xmlns:controls="clr-namespace:Cats.Telescope.VsExtension.Core.Controls"
             xmlns:converters="clr-namespace:Cats.Telescope.VsExtension.Core.Converters"
             xmlns:enums="clr-namespace:Cats.Telescope.VsExtension.Core.Enums"
             xmlns:viewmodels="clr-namespace:Cats.Telescope.VsExtension.ViewModels"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:s="clr-namespace:System;assembly=System.Runtime"
             d:DataContext="{d:DesignInstance Type=viewmodels:MainWindowViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="600"
             Name="TelescopeMainWindow"
             toolkit:Themes.UseVsTheme="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
            <converters:NodeTypeToSvgImageConverter x:Key="NodeTypeToSvgImageConverter"/>
            <converters:EnumValueToVisibilityConverter x:Key="EnumValueToVisibilityConverter"/>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <converters:BoolReverseConverter x:Key="BoolReverseConverter"/>
            <converters:JsonToDocumentConverter x:Key="JsonToDocumentConverter"/>

            <s:Boolean x:Key="True">True</s:Boolean>
            <s:Boolean x:Key="False">False</s:Boolean>

            <!-- rounded scope chip used above the tree -->
            <Style x:Key="ScopeChip" TargetType="ToggleButton">
                <Setter Property="Margin" Value="3,0"/>
                <Setter Property="Padding" Value="10,2"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="PART_ChipBorder"
                                    CornerRadius="10"
                                    Background="Transparent"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.AccentBorderKey}}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter x:Name="PART_ChipContent"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="PART_ChipBorder" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                                    <Setter TargetName="PART_ChipBorder" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"/>
                                    <Setter TargetName="PART_ChipContent" Property="TextElement.Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightTextKey}}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_ChipBorder" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Cats.Telescope.VsExtension;component/Core/Controls/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentControl Margin="5"
                            IsEnabled="{Binding ShowGlobalLoader, Converter={StaticResource BoolReverseConverter}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                    <controls:SearchControl Placeholder="Start typing to filter..." 
                                            FilterCommand="{Binding FilterCommand}"
                                            Delay="{x:Static core:TelescopeConstants+Filter.Delay}"
                                            SearchText="{Binding SearchText, Mode=TwoWay}"
                                            EnterKeyDefault="True"
                                            UseCaseOption="True" 
                                            SearchStarted="SearchControl_SearchStarted"
                                            IsCaseSensitive="{Binding IsCaseSensitive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal"
                                Grid.Column="2"
                                Margin="5,5,0,5">

                        <ToggleButton x:Name="FilterOptionsButton"
                                      IsChecked="{Binding IsFilterOptionsOpened, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding Source={x:Static core:Icons.CaretDown}}"
                                      Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                      VerticalAlignment="Center"
                                      Margin="0,2,0,0">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                                    </Path.RenderTransform>
                                </Path>
                                <TextBlock Text="Options"/>
                            </StackPanel>
                        </ToggleButton>

                        <Popup x:Name="FilterOptionsPopup"
                               IsOpen="{Binding IsFilterOptionsOpened, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=FilterOptionsButton}"
                               toolkit:Themes.UseVsTheme="True">

                            <Grid Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Filter Options"
                                               FontSize="{StaticResource SubtitleFontSize}"
                                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,5,0,0"
                                               Text="Select at least one option to filter the resources by"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                                    <StackPanel Grid.Row="2"
                                                Margin="0,5"
                                                Orientation="Vertical">

                                        <CheckBox Content="Resource Name"
                                                  IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter},ConverterParameter={x:Static enums:FilterBy.ResourceName}}"
                                                  Margin="2"/>
                                        <CheckBox Content="Resource Data"
                                                  IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter},ConverterParameter={x:Static enums:FilterBy.ResourceData}}"
                                                  Margin="2"/>
                                        <CheckBox Content="Tag Key"
                                                  IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter},ConverterParameter={x:Static enums:FilterBy.ResourceTagKeys}}"
                                                  Margin="2"/>
                                        <CheckBox Content="Tag Value"
                                                  IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter},ConverterParameter={x:Static enums:FilterBy.ResourceTagValues}}"
                                                  Margin="2"/>
                                        <CheckBox Content="Environment Variable Key"
                                                  IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter},ConverterParameter={x:Static enums:FilterBy.ResourceEnvironmentVariableKeys}}"
                                                  Margin="2"/>
                                        <CheckBox Content="Environment Variable Value"
                                                  IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter},ConverterParameter={x:Static enums:FilterBy.ResourceEnvironmentVariableValues}}"
                                                  Margin="2"/>
                                    </StackPanel>

                                    <Grid Grid.Row="3" Margin="0,5,0,0">
                                        <TextBlock HorizontalAlignment="Left"
                                                   VerticalAlignment="Center">
                                            <Hyperlink Focusable="True"
                                                       Command="{Binding ResetFilterScopesCommand}">
                                                <Run Text="Reset to name only"/>
                                            </Hyperlink>
                                        </TextBlock>

                                        <Button Content="Ok"
                                                HorizontalAlignment="Right"
                                                toolkit:Themes.UseVsTheme="True"
                                                Command="{Binding ToggleFilterOptionsVisibilityCommand}"
                                                CommandParameter="{StaticResource False}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Popup>

                    </StackPanel>

                    <!-- refresh and cancel stay enabled regardless of the search bar state -->
                    <StackPanel Orientation="Horizontal"
                                Grid.Column="3"
                                Margin="5,5,0,5"
                                VerticalAlignment="Center">
                        <controls:PathDataButton Command="{Binding RefreshCommand}"
                                                 PathData="{x:Static core:Icons.Refresh}"
                                                 ToolTip="Reload the resources from Azure"
                                                 Margin="3"/>
                        <controls:PathDataButton Command="{Binding CancelLoadingCommand}"
                                                 PathData="{x:Static core:Icons.Close}"
                                                 ToolTip="Cancel the loading"
                                                 Margin="3"/>
                    </StackPanel>
                </Grid>
            </ContentControl>

            <!-- quick filter scope chips - the options popup gives the fine-grained control -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="10,0,5,0">
                <TextBlock Text="Search in:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"
                           FontSize="11"
                           Opacity="0.7"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                <ToggleButton Style="{StaticResource ScopeChip}" Content="Name"
                              IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter}, ConverterParameter=ResourceName}"/>
                <ToggleButton Style="{StaticResource ScopeChip}" Content="Data"
                              IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter}, ConverterParameter=ResourceData}"/>
                <ToggleButton Style="{StaticResource ScopeChip}" Content="Tags"
                              IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter}, ConverterParameter=ResourceTagKeys|ResourceTagValues}"/>
                <ToggleButton Style="{StaticResource ScopeChip}" Content="Env Vars"
                              IsChecked="{Binding Path=SelectedFilterOptions, Converter={converters:FilterOptionFlagConverter}, ConverterParameter=ResourceEnvironmentVariableKeys|ResourceEnvironmentVariableValues}"/>

                <TextBlock Margin="15,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Opacity="0.7">
                    <Hyperlink Focusable="True"
                               Command="{Binding ToggleFilterOptionsVisibilityCommand}"
                               CommandParameter="{StaticResource True}">
                        <Run Text="More options"/>
                    </Hyperlink>
                </TextBlock>
            </StackPanel>

            <Grid x:Name="ContentGrid"
                  Grid.Row="2"
                  Margin="5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TreeGridColumn" MinWidth="150"/>
                    <ColumnDefinition x:Name="GridSplitterColumn" Width="Auto"/>
                    <ColumnDefinition x:Name="ResourceDataGridColumn" MinWidth="150" Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TreeView Grid.Row="0"
                              Margin="0,5,10,0"
                              Padding="5, 10"
                              ItemsSource="{Binding ResourceNodes}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              ScrollViewer.CanContentScroll="True">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="bindTreeViewExpand:Behaviours.ExpandingBehaviour" Value="{Binding ExpandCommand}"/>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </TreeView.ItemsPanel>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <!-- relay the window view model to the context menu, which lives outside the visual tree -->
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Style="{StaticResource VsContextMenu}"
                                                     ItemContainerStyle="{StaticResource VsContextMenuItem}">
                                            <MenuItem Header="Copy name"
                                                      Command="{Binding PlacementTarget.Tag.CopyNodeNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Copy ARM ID"
                                                      Command="{Binding PlacementTarget.Tag.CopyNodeArmIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                            <Separator/>
                                            <MenuItem Header="Open in Portal"
                                                      Command="{Binding PlacementTarget.Tag.OpenResourceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Path=ResourceNodes}">
                                <StackPanel Orientation="Horizontal">
                                    <svg:SvgViewbox x:Name="NodeIcon"
                                                    Source="{Binding Type, Converter={StaticResource NodeTypeToSvgImageConverter}}"
                                                    Height="15"
                                                    Margin="3"/>

                                    <!-- inline spinner shown instead of the node content while its children are loading -->
                                    <Grid x:Name="NodeSpinner"
                                          Width="14" Height="14"
                                          Margin="3"
                                          Visibility="Collapsed">
                                        <Ellipse Stroke="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                                 Opacity="0.25"
                                                 StrokeThickness="2"/>
                                        <Ellipse Stroke="{DynamicResource {x:Static vsshell:VsBrushes.AccentBorderKey}}"
                                                 StrokeThickness="2"
                                                 StrokeDashArray="10 14"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="NodeSpinnerRotate"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="NodeSpinnerRotate"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             From="0"
                                                                             To="360"
                                                                             Duration="0:0:0.8"
                                                                             RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>

                                    <CheckBox x:Name="NodeCheckbox"
                                              IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center"
                                              Margin="2"/>
                                    <TextBlock x:Name="NodeText"
                                               Text="{Binding Id}"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource NormalFontSize}"/>
                                </StackPanel>

                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Empty">
                                        <Setter TargetName="NodeIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="NodeCheckbox" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="NodeText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="NodeSpinner" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <e:Interaction.Behaviors>
                            <bindTreeViewExpand:BindableSelectedItemBehavior SelectedItem="{Binding SelectedNode, Mode=TwoWay}" />
                        </e:Interaction.Behaviors>
                    </TreeView>

                    <controls:PathDataButton Grid.Row="0"
                                             VerticalAlignment="Top"
                                             HorizontalAlignment="Right"
                                             Command="{Binding CopyToClipboardCommand}"
                                             Margin="30,8"
                                             PathData="{x:Static core:Icons.Copy}"
                                             x:Name="CopyNodesToClipboardButton"
                                             ToolTip="Copy selected nodes to clipboard"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=reverse}"/>

                    <Popup x:Name="ClipboardPopup"
                           Placement="Bottom"
                           toolkit:Themes.UseVsTheme="True">
                        <Grid Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}">
                            <TextBlock x:Name="ClipboardPopupText"
                                       Text="{Binding CopyPopupText}"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                                       Margin="10"/>
                        </Grid>
                    </Popup>

                    <controls:LoadingForm Grid.Row="0"
                                          Margin="0,5,10,0"
                                          Text="{Binding BusyText, TargetNullValue=Loading...}"
                                          Visibility="{Binding ShowGlobalLoader, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- search feedback: empty state with scope suggestions and a tree summary -->
                    <StackPanel Grid.Row="1"
                                Margin="0,5,10,5">
                        <StackPanel Visibility="{Binding IsEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                                    HorizontalAlignment="Center"
                                    Margin="0,5">
                            <TextBlock HorizontalAlignment="Center"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}">
                                <Run Text="No results for"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SearchText, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>

                            <TextBlock Text="Search also in:"
                                       Margin="0,8,0,0"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

                            <ItemsControl ItemsSource="{Binding ScopeSuggestions}"
                                          HorizontalAlignment="Center"
                                          Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="6,2">
                                            <Hyperlink Focusable="True"
                                                       Command="{Binding Path=DataContext.EnableScopeCommand, ElementName=TelescopeMainWindow}"
                                                       CommandParameter="{Binding Flags}">
                                                <Run Text="{Binding Label, Mode=OneWay}"/>
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding TreeStatusText}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>
                    </StackPanel>
                </Grid>

                <GridSplitter x:Name="ContentGridSplitter" 
                              Grid.Column="1"
                              ShowsPreview="False" 
                              Width="3"
                              Margin="0, -15"
                              Background="{DynamicResource {x:Static vsshell:VsBrushes.AccentBorderKey}}"
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Stretch" />

                <Grid Grid.Column="2"
                      Margin="10, 5, 5, 0"
                      HorizontalAlignment="Stretch"
                      Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed, UpdateSourceTrigger=PropertyChanged}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal"
                                Margin="5">
                            <svg:SvgViewbox Source="{Binding SelectedNode.Type, Converter={StaticResource NodeTypeToSvgImageConverter}}" 
                                        Height="25"
                                        Margin="3"/>
                            <TextBlock Text="{Binding SelectedNode.Id}"
                                   VerticalAlignment="Center"
                                   FontSize="{StaticResource TitleFontSize}"
                                   controls:HighlightableTextBlock.Active="{Binding SelectedFilterOptions, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='ResourceName'}"
                                   controls:HighlightableTextBlock.HighlightBrush="{StaticResource HighlightBrush}"
                                   controls:HighlightableTextBlock.HighlightTextBrush="{StaticResource HighlightTextBrush}"
                                   controls:HighlightableTextBlock.HightlightText="{Binding SearchText}"
                                   Margin="2,0,0,0"/>

                            
                        </StackPanel>

                        <!--Actions-->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <controls:PathDataButton VerticalAlignment="Center"
                                                     Command="{Binding CopyToClipboardCommand}"
                                                     CommandParameter="name"
                                                     PathData="{x:Static core:Icons.Copy}"
                                                     x:Name="CopyNameToClipboardButton"
                                                     ToolTip="Copy name to clipboard"/>

                            <Button Command="{Binding OpenResourceCommand}"
                                    VerticalAlignment="Center"
                                    Margin="3"
                                    MinWidth="25"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    x:Name="ResourceLinkButton"
                                    ToolTip="Open the resource in Azure Portal"
                                    Visibility="{Binding SelectedNode.LinkToResource, Converter={StaticResource NullToCollapsedConverter}}">
                                <Button.Background>
                                    <ImageBrush ImageSource="pack://application:,,,/Cats.Telescope.VsExtension;component/Resources/azure-portal25x25.png"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TabControl Grid.Row="1"
                                Margin="0"
                                FontSize="{StaticResource NormalFontSize}"
                                toolkit:Themes.UseVsTheme="True"
                                Visibility="{Binding SelectedNode.Data, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter='LogicApp', FallbackValue=Collapsed}">
                        <TabItem toolkit:Themes.UseVsTheme="True">

                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Configuration JSON" />
                                    <TextBlock Text="{Binding SelectedNode.FilterMatches.ByDataCount, StringFormat='({0})'}"
                                               Visibility="{Binding SelectedNode.FilterMatches.Matches, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Margin="2,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                                <Grid>
                                    <avalonEdit:TextEditor
                                        x:Name="ConfigurationTextEditor"
                                        toolkit:Themes.UseVsTheme="True"
                                        Document="{Binding SelectedNode.Data, FallbackValue={x:Null}, Converter={StaticResource JsonToDocumentConverter}, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="True"
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"
                                        SyntaxHighlighting="{Binding HighlightingDefinition, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">

                                        <avalonEdit:TextEditor.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Command="Copy" Header="Copy">
                                                    <!--MenuItem.Icon>
                                                        <Image Source="/Edi;component/Images/App/Edit_Copy32.png" Height="16"/>
                                                    </MenuItem.Icon-->
                                                </MenuItem>
                                            </ContextMenu>
                                        </avalonEdit:TextEditor.ContextMenu>
                                    </avalonEdit:TextEditor>
                                </Grid>
                            
                        </TabItem>
                        <TabItem toolkit:Themes.UseVsTheme="True"
                                 Visibility="{Binding SelectedNode.Tags, Converter={StaticResource NullToCollapsedConverter}}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Tags" />
                                    <TextBlock Text="{Binding SelectedNode.FilterMatches.ByTagsCount, StringFormat='({0})'}"
                                               Visibility="{Binding SelectedNode.FilterMatches.Matches, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Margin="2,0"/>
                                </StackPanel>
                            </TabItem.Header>
                            
                            <ListView ItemsSource="{Binding SelectedNode.Tags}"
                                      BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <!-- relay the window view model to the context menu, which lives outside the visual tree -->
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu Style="{StaticResource VsContextMenu}"
                                                             ItemContainerStyle="{StaticResource VsContextMenuItem}">
                                                    <MenuItem Header="Copy name"
                                                              Command="{Binding PlacementTarget.Tag.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding Key}"/>
                                                    <MenuItem Header="Copy value"
                                                              Command="{Binding PlacementTarget.Tag.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding Value}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding Key}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       controls:HighlightableTextBlock.Active="{Binding Path=DataContext.SelectedFilterOptions, ElementName=TelescopeMainWindow, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='ResourceTagKeys', UpdateSourceTrigger=PropertyChanged}"
                                                       controls:HighlightableTextBlock.HighlightBrush="{StaticResource HighlightBrush}"
                                                       controls:HighlightableTextBlock.HighlightTextBrush="{StaticResource HighlightTextBrush}"
                                                       controls:HighlightableTextBlock.CaseSensitive="{Binding Path=DataContext.IsCaseSensitive, ElementName=TelescopeMainWindow, UpdateSourceTrigger=PropertyChanged}"
                                                       controls:HighlightableTextBlock.HightlightText="{Binding Path=DataContext.SearchText, ElementName=TelescopeMainWindow}"/>

                                            <TextBlock Text="{Binding Value, StringFormat=' - {0}'}"
                                                       FontSize="{StaticResource NormalFontSize}"
                                                       controls:HighlightableTextBlock.Active="{Binding Path=DataContext.SelectedFilterOptions, ElementName=TelescopeMainWindow, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='ResourceTagValues', UpdateSourceTrigger=PropertyChanged}"
                                                       controls:HighlightableTextBlock.HighlightBrush="{StaticResource HighlightBrush}"
                                                       controls:HighlightableTextBlock.HighlightTextBrush="{StaticResource HighlightTextBrush}"
                                                       controls:HighlightableTextBlock.CaseSensitive="{Binding Path=DataContext.IsCaseSensitive, ElementName=TelescopeMainWindow, UpdateSourceTrigger=PropertyChanged}"
                                                       controls:HighlightableTextBlock.HightlightText="{Binding Path=DataContext.SearchText, ElementName=TelescopeMainWindow}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabItem>
                        <TabItem toolkit:Themes.UseVsTheme="True"
                                 Visibility="{Binding SelectedNode.EnvironmentVariables, Converter={StaticResource NullToCollapsedConverter}}">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Environment Variables" />
                                    <TextBlock Text="{Binding SelectedNode.FilterMatches.ByEnvironmentVariablesCount, StringFormat='({0})'}"
                                               Visibility="{Binding SelectedNode.FilterMatches.Matches, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Margin="2,0"/>
                                    <ToggleButton Content="Show values"
                                                  FontSize="11"
                                                  Padding="4,0"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  toolkit:Themes.UseVsTheme="True"
                                                  IsChecked="{Binding ShowEnvironmentVariableValues, Mode=TwoWay}"/>
                                </StackPanel>
                            </TabItem.Header>

                            <ListView ItemsSource="{Binding SelectedNode.EnvironmentVariables}"
                                      BorderThickness="0">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <!-- relay the window view model to the context menu, which lives outside the visual tree -->
                                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu Style="{StaticResource VsContextMenu}"
                                                             ItemContainerStyle="{StaticResource VsContextMenuItem}">
                                                    <MenuItem Header="Copy name"
                                                              Command="{Binding PlacementTarget.Tag.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding Key}"/>
                                                    <MenuItem Header="Copy value"
                                                              Command="{Binding PlacementTarget.Tag.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                              CommandParameter="{Binding Value}"/>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" Margin="0,2">
                                            <!-- name -->
                                            <TextBlock Text="{Binding Key}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       controls:HighlightableTextBlock.Active="{Binding Path=DataContext.SelectedFilterOptions, ElementName=TelescopeMainWindow, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='ResourceEnvironmentVariableKeys', UpdateSourceTrigger=PropertyChanged}"
                                                       controls:HighlightableTextBlock.HighlightBrush="{StaticResource HighlightBrush}"
                                                       controls:HighlightableTextBlock.HighlightTextBrush="{StaticResource HighlightTextBrush}"
                                                       controls:HighlightableTextBlock.CaseSensitive="{Binding Path=DataContext.IsCaseSensitive, ElementName=TelescopeMainWindow, UpdateSourceTrigger=PropertyChanged}"
                                                       controls:HighlightableTextBlock.HightlightText="{Binding Path=DataContext.SearchText, ElementName=TelescopeMainWindow}"/>

                                            <!-- value -->
                                            <StackPanel Orientation="Horizontal">
                                                <!-- the value is masked by default since it often contains a secret -->
                                                <TextBlock Text=" - ••••••••"
                                                           FontSize="{StaticResource NormalFontSize}"
                                                           Opacity="0.7"
                                                           Visibility="{Binding Path=DataContext.ShowEnvironmentVariableValues, ElementName=TelescopeMainWindow, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=reverse}"/>

                                                <TextBlock Text="{Binding Value, StringFormat=' - {0}'}"
                                                           FontSize="{StaticResource NormalFontSize}"
                                                           Visibility="{Binding Path=DataContext.ShowEnvironmentVariableValues, ElementName=TelescopeMainWindow, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           controls:HighlightableTextBlock.Active="{Binding Path=DataContext.SelectedFilterOptions, ElementName=TelescopeMainWindow, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='ResourceEnvironmentVariableValues', UpdateSourceTrigger=PropertyChanged}"
                                                           controls:HighlightableTextBlock.HighlightBrush="{StaticResource HighlightBrush}"
                                                           controls:HighlightableTextBlock.HighlightTextBrush="{StaticResource HighlightTextBrush}"
                                                           controls:HighlightableTextBlock.CaseSensitive="{Binding Path=DataContext.IsCaseSensitive, ElementName=TelescopeMainWindow, UpdateSourceTrigger=PropertyChanged}"
                                                           controls:HighlightableTextBlock.HightlightText="{Binding Path=DataContext.SearchText, ElementName=TelescopeMainWindow}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabItem>
                    </TabControl>
                </Grid>

                <controls:PathDataButton VerticalAlignment="Top"
                                         HorizontalAlignment="Right"
                                         Grid.Column="2"
                                         Margin="0,95,35,0"
                                         Command="{Binding CopyToClipboardCommand}"
                                         CommandParameter="data"
                                         PathData="{x:Static core:Icons.Copy}"
                                         x:Name="CopyDataToClipboardButton"
                                         ToolTip="Copy data to clipboard"
                                         Visibility="{Binding SelectedNode.Data, Converter={StaticResource NullToCollapsedConverter}, FallbackValue=Collapsed}"/>

                <!-- details pane placeholder shown while nothing is selected -->
                <TextBlock Grid.Column="2"
                           Text="Select a resource on the left to see its configuration, tags and environment variables"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"
                           FontStyle="Italic"
                           Opacity="0.6"
                           FontSize="12"
                           Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                           Visibility="{Binding SelectedNode, Converter={StaticResource NullToCollapsedConverter}, ConverterParameter=reverse, FallbackValue=Visible}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
