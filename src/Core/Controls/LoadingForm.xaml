<UserControl x:Class="Cats.Telescope.VsExtension.Core.Controls.LoadingForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Cats.Telescope.VsExtension.Core.Controls"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="400">

    <Grid>
        <!-- dims the content behind the form -->
        <Grid Background="Black"
              Opacity="0.35"/>

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=controls:LoadingForm}, TargetNullValue=Loading...}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"
                       FontSize="14"
                       Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"/>

            <!-- spinner -->
            <Grid HorizontalAlignment="Center"
                  Width="44" Height="44"
                  Margin="0,0,0,12">
                <!-- spinner track -->
                <Ellipse Stroke="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                         Opacity="0.2"
                         StrokeThickness="3"/>
                <!-- rotating arc -->
                <Ellipse Stroke="{DynamicResource {x:Static vsshell:VsBrushes.AccentBorderKey}}"
                         StrokeThickness="3"
                         StrokeDashArray="60 80"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:1.2"
                                                     RepeatBehavior="Forever"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>

            <ProgressBar IsIndeterminate="True"
                         Width="220"
                         Height="3"
                         Margin="0,4,0,0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource {x:Static vsshell:VsBrushes.AccentBorderKey}}"/>
        </StackPanel>
    </Grid>
</UserControl>
