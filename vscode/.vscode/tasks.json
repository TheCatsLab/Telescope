{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": {
          "regexp": "^\\s*(.*)\\((\\d+),(\\d+)\\):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*\\[watch\\]\\s*build started",
          "endsPattern": "^\\s*\\[watch\\]\\s*build finished"
        }
      }
    }
  ]
}
